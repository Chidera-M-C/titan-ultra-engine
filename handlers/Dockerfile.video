FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

ARG HF_TOKEN=""
ARG CIVITAI_TOKEN=""

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y \
    ffmpeg libsm6 libxext6 git wget curl \
    && rm -rf /var/lib/apt/lists/*

# Install a stable ComfyUI commit that worked with Torch 2.4
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /comfyui && \
    cd /comfyui && \
    git checkout 5ac3b26

WORKDIR /comfyui

# Install requirements first
RUN pip install --no-cache-dir -r requirements.txt

# Hard pin comfy_kitchen to avoid the list[int] schema crash
# (this is the version that was compatible with the previous working builds)
RUN pip install --no-cache-dir "comfy-kitchen==0.1.4" || \
    pip install --no-cache-dir "comfy-kitchen==0.1.3" || true

# Install custom nodes
RUN cd /comfyui/custom_nodes && \
    git clone https://github.com/kijai/ComfyUI-WanVideoWrapper.git && \
    cd ComfyUI-WanVideoWrapper && \
    pip install --no-cache-dir -r requirements.txt || true

RUN cd /comfyui/custom_nodes && \
    git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git && \
    cd ComfyUI-VideoHelperSuite && \
    pip install --no-cache-dir -r requirements.txt || true

# Handler dependencies
RUN pip install --no-cache-dir \
    runpod==1.6.2 \
    requests==2.31.0 \
    Pillow==10.3.0 \
    "yarl==1.9.4" \
    "transformers==4.46.3"

# Copy and run the dedicated download script
COPY download_models_video.py /tmp/download_models_video.py

RUN HF_TOKEN=${HF_TOKEN} CIVITAI_TOKEN=${CIVITAI_TOKEN} \
    python -u /tmp/download_models_video.py || \
    (echo "===== DOWNLOAD FAILED =====" && \
     find /comfyui/models -type f -exec ls -lh {} \; && \
     exit 1)

RUN rm -f /tmp/download_models_video.py

WORKDIR /app
COPY handler_video.py .

CMD ["python", "-u", "handler_video.py"]
