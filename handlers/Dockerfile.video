FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsm6 \
    libxext6 \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Python deps
RUN pip install --no-cache-dir --upgrade pip

RUN pip install --no-cache-dir \
    imageio==2.34.0 \
    imageio-ffmpeg==0.5.1 \
    sentencepiece==0.2.0 \
    protobuf==4.25.3

RUN pip install --no-cache-dir \
    runpod==1.6.2 \
    huggingface_hub==0.22.2 \
    safetensors==0.4.3 \
    requests==2.31.0 \
    Pillow==10.3.0

RUN pip install --no-cache-dir peft==0.10.0

RUN pip install --no-cache-dir \
    diffusers==0.31.0 \
    transformers==4.40.0 \
    accelerate==0.28.0

# Copy handler and downloader
COPY handler_video.py .
COPY download_models_video.py .

# Pre-download models at build time if CIVITAI_TOKEN is set
# RunPod bakes these into the image so cold start is fast
ARG CIVITAI_TOKEN=""
ARG HF_TOKEN=""
ENV CIVITAI_TOKEN=${CIVITAI_TOKEN}
ENV HF_TOKEN=${HF_TOKEN}

RUN python download_models_video.py

# Update
# Start handler
CMD ["python", "-u", "handler_video.py"]
