FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgl1-mesa-glx \
    git \
    wget \
    tzdata \
    && ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime \
    && dpkg-reconfigure --frontend noninteractive tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir "numpy>=1.26.0,<2.0.0"
RUN pip install --no-cache-dir \
    requests \
    Pillow

# Install ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI
WORKDIR /app/ComfyUI

RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir \
    aiohttp \
    torchvision \
    torchaudio \
    spandrel \
    kornia \
    einops \
    transformers \
    tokenizers \
    sentencepiece

# ── krea2edit: pull latest main branch directly (contains wrapper signature fix)
ARG CACHEBUST=2
RUN echo "bust=$CACHEBUST" && \
    git clone https://github.com/lbouaraba/comfyui-krea2edit.git custom_nodes/comfyui-krea2edit

RUN git clone https://github.com/rgthree/rgthree-comfy.git custom_nodes/rgthree-comfy && \
    pip install --no-cache-dir -r custom_nodes/rgthree-comfy/requirements.txt || true

RUN git clone https://github.com/alexopus/ComfyUI-Image-Saver.git custom_nodes/ComfyUI-Image-Saver && \
    pip install --no-cache-dir -r custom_nodes/ComfyUI-Image-Saver/requirements.txt || true

RUN mkdir -p /app/ComfyUI/workflows

COPY download_models_edit.py /app/
COPY handler_edit.py /app/
COPY lustify_krea_edit_api.json /app/ComfyUI/workflows/

ARG HF_TOKEN
RUN HF_TOKEN=${HF_TOKEN} python /app/download_models_edit.py

WORKDIR /app

# Upgrade RunPod SDK & install Brotli / aiohttp speedups to decode RunPod API responses
RUN pip install --no-cache-dir "runpod>=1.7.0" brotli "aiohttp[speedups]>=3.10.0"

CMD ["python", "handler_edit.py"]
