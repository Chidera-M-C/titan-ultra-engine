FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

WORKDIR /app

# Install missing system libraries
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# Install numpy first and lock it down before anything else touches it
RUN pip install --no-cache-dir "numpy==1.24.4"

# Install core packages with versions known to work together
RUN pip install --no-cache-dir \
    accelerate==0.28.0 \
    transformers==4.40.0 \
    diffusers==0.27.2 \
    safetensors==0.4.3 \
    huggingface_hub==0.22.2 \
    Pillow==10.3.0 \
    requests==2.31.0

# Install peft AFTER transformers and accelerate so the backend is recognized
# Install peft AFTER transformers and accelerate so the backend is recognized
RUN pip install --no-cache-dir "peft==0.10.0"

# Install remaining packages
RUN pip install --no-cache-dir \
    runpod==1.6.2 \
    timm==0.9.16 \
    controlnet-aux==0.0.7 \
    opencv-python-headless==4.9.0.80 \
    matplotlib==3.7.5

# Patch out mediapipe (not needed, causes import errors)
RUN sed -i 's/from .mediapipe_face import MediapipeFaceDetector/pass  # mediapipe disabled/' \
    /opt/conda/lib/python3.10/site-packages/controlnet_aux/__init__.py

# Force numpy to stay at 1.24.4 — some packages silently upgrade it
RUN pip install --no-cache-dir --force-reinstall "numpy==1.24.4"

COPY handler_edit.py .

# Verify everything loads cleanly
RUN python -c "import torch; print('torch OK:', torch.__version__)"
RUN python -c "import numpy; print('numpy OK:', numpy.__version__)"
RUN python -c "from diffusers import StableDiffusionXLControlNetPipeline, ControlNetModel; print('diffusers OK')"
RUN python -c "from controlnet_aux import OpenposeDetector; print('controlnet_aux OK')"
RUN python -c "import peft; print('peft OK:', peft.__version__)"
RUN python -c "import runpod; print('runpod OK')"
RUN python -c "import cv2; print('cv2 OK')"

CMD ["python", "handler_edit.py"]
