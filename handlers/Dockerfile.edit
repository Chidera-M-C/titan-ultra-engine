FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /workspace

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    HF_HOME=/workspace/huggingface_cache

RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgl1-mesa-glx \
    wget \
    aria2 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir \
    runpod \
    requests \
    Pillow \
    numpy \
    diffusers \
    transformers \
    accelerate \
    controlnet_aux \
    opencv-python-headless \
    huggingface_hub

COPY download_models_edit.py /workspace/
COPY handler_edit.py /workspace/

# Build-time model caching
ARG HF_TOKEN
ARG CIVITAI_TOKEN
RUN HF_TOKEN=${HF_TOKEN} CIVITAI_TOKEN=${CIVITAI_TOKEN} python /workspace/download_models_edit.py

CMD ["python", "-u", "handler_edit.py"]
