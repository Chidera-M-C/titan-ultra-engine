FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgl1-mesa-glx \
    git \
    wget \
    tzdata \
    aria2 \
    libgoogle-perftools-dev \
    && ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime \
    && dpkg-reconfigure --frontend noninteractive tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir "numpy>=1.26.0,<2.0.0"
RUN pip install --no-cache-dir \
    requests \
    Pillow \
    opencv-python-headless \
    piexif \
    matplotlib \
    insightface \
    onnxruntime-gpu

# Cache bust for ComfyUI to ensure fresh unpinned clone
ARG COMFY_CACHEBUST=1
RUN echo "comfy-bust=$COMFY_CACHEBUST"

# Install ComfyUI properly
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI
WORKDIR /app/ComfyUI

RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir \
    aiohttp \
    torchvision \
    torchaudio \
    spandrel \
    kornia \
    einops \
    transformers \
    tokenizers \
    sentencepiece

# Custom Nodes - PuLID Flux & dependencies
RUN git clone https://github.com/balazik/ComfyUI-PuLID-Flux.git custom_nodes/ComfyUI-PuLID-Flux
RUN git clone https://github.com/Fannovel16/comfyui_controlnet_aux.git custom_nodes/comfyui_controlnet_aux
RUN git clone https://github.com/rgthree/rgthree-comfy.git custom_nodes/rgthree-comfy
RUN git clone https://github.com/alexopus/ComfyUI-Image-Saver.git custom_nodes/ComfyUI-Image-Saver

# Install requirements of custom nodes
RUN pip install --no-cache-dir -r custom_nodes/comfyui_controlnet_aux/requirements.txt || true
RUN pip install --no-cache-dir -r custom_nodes/ComfyUI-PuLID-Flux/requirements.txt || true

# --------------------------------------------------------------------------
# BULLETPROOF FIX: Safely strip trailing commas and append **kwargs
# --------------------------------------------------------------------------
RUN python3 -c '\
import os, re;\
def replacer(m):\
    return m.group(1).rstrip(", \\t\\n\\r") + ", **kwargs" + m.group(2);\
for root, dirs, files in os.walk("custom_nodes/ComfyUI-PuLID-Flux"):\
    for file in files:\
        if file.endswith(".py"):\
            path = os.path.join(root, file);\
            with open(path, "r", encoding="utf-8") as f: code = f.read();\
            patched = re.sub(r"(def forward_orig\s*\([^)]*?)(\)\s*(?:->\s*[^:]*)?:)", replacer, code);\
            with open(path, "w", encoding="utf-8") as f: f.write(patched);\
' || true

RUN mkdir -p /app/ComfyUI/workflows
RUN mkdir -p /app/ComfyUI/models/pulid
RUN mkdir -p /app/ComfyUI/models/insightface/models

COPY download_models_edit.py /app/
COPY handler_edit.py /app/
COPY flux_pulid_edit.json /app/ComfyUI/workflows/flux_pulid_edit.json

ARG HF_TOKEN
ARG CIVITAI_TOKEN
RUN HF_TOKEN=${HF_TOKEN} CIVITAI_TOKEN=${CIVITAI_TOKEN} python /app/download_models_edit.py

WORKDIR /app

RUN pip install --no-cache-dir "runpod>=1.7.0" brotli "aiohttp[speedups]>=3.10.0"

CMD ["python", "handler_edit.py"]
