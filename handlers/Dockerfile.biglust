FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    diffusers==0.27.0 \
    transformers==4.38.0 \
    accelerate==0.27.0 \
    safetensors==0.4.2 \
    runpod==1.6.2 \
    Pillow==10.2.0 \
    requests==2.31.0

# Accept CivitAI token as build arg
ARG CIVITAI_TOKEN

# Download all models at build time
COPY download_models_biglust.py .
RUN CIVITAI_TOKEN=${CIVITAI_TOKEN} python download_models_biglust.py
