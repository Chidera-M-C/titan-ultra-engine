FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

WORKDIR /app

RUN pip install --no-cache-dir \
    diffusers==0.27.0 \
    transformers==4.38.0 \
    accelerate==0.27.0 \
    safetensors==0.4.2 \
    runpod==1.6.2 \
    Pillow==10.2.0 \
    requests==2.31.0

COPY handler_explore.py .

CMD ["python", "handler_explore.py"]
