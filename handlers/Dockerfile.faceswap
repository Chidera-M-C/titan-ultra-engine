FROM python:3.10-bullseye

WORKDIR /app

RUN apt-get update && apt-get install -y \
    g++ \
    git \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    runpod==1.6.2 \
    insightface==0.7.3 \
    onnxruntime==1.17.1 \
    opencv-python-headless==4.9.0.80 \
    Pillow==10.2.0 \
    numpy==1.24.4 \
    requests==2.31.0

# Pre-download InsightFace buffalo_l and InSwapper models
COPY download_faceswap_models.py .
RUN python download_faceswap_models.py

COPY handler_faceswap.py .

CMD ["python", "handler_faceswap.py"]

# updated
